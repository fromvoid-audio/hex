+pub(super) unsafe fn detach(this: &Object) {
+    unsafe {
+        if let Some(bridge) = take_owned_ivar::<Arc<NativeBridge>>(this, c"semanticBridge") {
+            // The owning ivar is already null before revoke releases reentrant callbacks/cache.
+            revoke(&bridge);
+            drop(bridge);
+        }
+    }
+}
