+        let toward = if points_left { -1.0 } else { 1.0 };
+        let bracket = if points_left { 1.0 } else { -1.0 };
+        let segments = [
+            (NSPoint::new(center_x, 4.0), NSPoint::new(center_x, 20.0)),
+            (
