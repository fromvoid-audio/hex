+        ns_string(if state.accessibility_unavailable {
+            "hex controls unavailable: invalid or oversized accessibility snapshot"
+        } else {
+            "hex controls"
+        })
+    }
+}
+
+extern "C" fn accessibility_hidden(this: &Object, _: Sel) -> BOOL {
+    if semantic_node(this).is_none() {
+        YES
+    } else {
+        NO
+    }
+}
+
+fn release_accessibility_elements(elements: Vec<id>) {
+    for element in elements {
+        unsafe {
+            let _: () = msg_send![element, release];
+        }
+    }
+}
