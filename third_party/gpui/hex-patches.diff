+    let Some(data) = semantic_state(this) else {
+        return nil;
+    };
+    if current_node(data).is_none() {
+        return nil;
+    }
+    let parent = WINDOWS.with(|registry| {
+        registry
+            .borrow()
+            .get(data.bridge.key)
+            .map_or(nil, |entry| entry.view)
