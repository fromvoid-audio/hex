+    /// Current bounded, actually mounted semantic nodes in rendered order.
+    pub fn accessibility_nodes(&self) -> impl Iterator<Item = &crate::AccessibilityNode> {
+        self.rendered_frame
+            .accessibility
+            .nodes
+            .iter()
+            .filter(|_| !self.rendered_frame.accessibility.invalid)
+            .map(|(node, _)| node)
+    }
