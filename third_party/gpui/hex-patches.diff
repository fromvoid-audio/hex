+        decl.add_method(
+            sel!(isAccessibilityEnabled),
+            accessibility_enabled as extern "C" fn(&Object, Sel) -> BOOL,
+        );
+        decl.add_method(
+            sel!(isAccessibilityFocused),
+            accessibility_focused as extern "C" fn(&Object, Sel) -> BOOL,
