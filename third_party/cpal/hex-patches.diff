+/// Current-thread time constraint for an auxiliary audio worker.
+///
+/// Construct on a dedicated, ordinarily scheduled worker. No call belongs on
+/// the device callback. The caller owns admission, deadlines and retirement.
+pub struct WorkerTimeConstraint {
+    thread: mach2::mach_types::thread_t,
+    policy: mach2::thread_policy::thread_time_constraint_policy_data_t,
+    active: bool,
+    _current_thread_only: std::marker::PhantomData<*mut ()>,
+}
+
+impl WorkerTimeConstraint {
+    /// Acquire the current thread and validate the time constraint without
+    /// changing its scheduling class. Existing real-time threads refuse.
+    pub fn for_current_thread(
+        period: std::time::Duration,
+        computation: std::time::Duration,
+        constraint: std::time::Duration,
+    ) -> Result<Self, BackendSpecificError> {
+        use mach2::{mach_init::mach_thread_self, port::MACH_PORT_NULL, thread_policy::*};
+
+        let refused = || BackendSpecificError {
+            description: "invalid auxiliary audio worker time constraint".into(),
+        };
+        if computation.is_zero() || computation > constraint / 2 || constraint > period {
+            return Err(refused());
+        }
+        let ratio = super::read_host_timebase()?;
+        let ticks = |duration: std::time::Duration| {
+            let numerator = duration.as_nanos().checked_mul(u128::from(ratio.denom))?;
+            u32::try_from(numerator.checked_div(u128::from(ratio.numer))?)
+                .ok()
+                .filter(|value| *value != 0)
+        };
+        let policy = thread_time_constraint_policy_data_t {
+            period: ticks(period).ok_or_else(refused)?,
+            computation: ticks(computation).ok_or_else(refused)?,
+            constraint: ticks(constraint).ok_or_else(refused)?,
+            preemptible: 1,
+        };
+        // SAFETY: this returns a send right for the calling thread. The
+        // non-Send owner deallocates it even when the policy check fails.
+        let thread = unsafe { mach_thread_self() };
+        if thread == MACH_PORT_NULL {
+            return Err(refused());
+        }
+        let owner = Self {
+            thread,
+            policy,
+            active: false,
+            _current_thread_only: std::marker::PhantomData,
+        };
+        if !owner.is_ordinary()? {
+            return Err(refused());
+        }
+        Ok(owner)
+    }
+
+    /// Apply the configured time constraint to the current worker.
+    pub fn enter(&mut self) -> Result<(), BackendSpecificError> {
+        use mach2::thread_policy::*;
+        if !self.active {
+            // SAFETY: the native record matches the flavor and count and the
+            // current worker still owns the acquired thread right.
+            let status = unsafe {
+                thread_policy_set(
+                    self.thread,
+                    THREAD_TIME_CONSTRAINT_POLICY,
+                    (&mut self.policy as *mut thread_time_constraint_policy_data_t).cast(),
+                    THREAD_TIME_CONSTRAINT_POLICY_COUNT,
+                )
+            };
+            super::check_os_status(status)?;
+            self.active = true;
+        }
+        Ok(())
+    }
+
+    /// Return to ordinary scheduling. The caller may reapply its own QoS.
+    pub fn leave(&mut self) -> Result<(), BackendSpecificError> {
+        use mach2::thread_policy::*;
+        if self.active {
+            // SAFETY: the standard-policy flavor takes a zero-word argument.
+            let status = unsafe {
+                thread_policy_set(
+                    self.thread,
+                    THREAD_STANDARD_POLICY,
+                    std::ptr::null_mut(),
+                    THREAD_STANDARD_POLICY_COUNT,
+                )
+            };
+            super::check_os_status(status)?;
+            self.active = false;
+        }
+        Ok(())
+    }
+
+    fn is_ordinary(&self) -> Result<bool, BackendSpecificError> {
+        use mach2::thread_policy::*;
+        let mut policy = self.policy;
+        let mut count = THREAD_TIME_CONSTRAINT_POLICY_COUNT;
+        let mut default = 0;
+        // SAFETY: the native getter writes into initialized storage for this
+        // flavor, count and status flag.
+        let status = unsafe {
+            thread_policy_get(
+                self.thread,
+                THREAD_TIME_CONSTRAINT_POLICY,
+                (&mut policy as *mut thread_time_constraint_policy_data_t).cast(),
+                &mut count,
+                &mut default,
+            )
+        };
+        super::check_os_status(status)?;
+        Ok(default != 0)
+    }
+}
+
+impl Drop for WorkerTimeConstraint {
+    fn drop(&mut self) {
+        let _ = self.leave();
+        // SAFETY: release exactly the owned current-thread send right.
+        unsafe {
+            mach2::mach_port::mach_port_deallocate(mach2::traps::mach_task_self(), self.thread);
+        }
+    }
+}
+
+/// Real-time-safe Mach kernel semaphore for waking auxiliary audio workers.
+///
+/// Construct and drop on control. `signal` and `signal_all` issue a single
+/// non-blocking Mach trap with zero allocation and zero user-space locks,
+/// making them safe to invoke from CoreAudio callbacks when workers are parked.
+pub struct WorkerSemaphore {
+    sem: mach2::mach_types::semaphore_t,
+}
+
+// SAFETY: Mach semaphore port names are process-wide kernel objects safe to
+// signal and wait on concurrently from any thread in the owning task.
+unsafe impl Send for WorkerSemaphore {}
+unsafe impl Sync for WorkerSemaphore {}
+
+mod mach_semaphore_ffi {
+    use mach2::{
+        clock_types::mach_timespec_t,
+        kern_return::kern_return_t,
+        mach_types::{semaphore_t, task_t},
+        sync_policy::sync_policy_t,
+    };
+
+    // Match Apple's `<mach/semaphore.h>` and `<mach/task.h>` ABI directly:
+    // `mach2` 0.4/0.5 declares `semaphore_*` with `*mut semaphore_t` instead
+    // of by-value `semaphore_t`.
+    extern "C" {
+        pub(super) fn semaphore_create(
+            task: task_t,
+            semaphore: *mut semaphore_t,
+            policy: sync_policy_t,
+            value: std::ffi::c_int,
+        ) -> kern_return_t;
+        pub(super) fn semaphore_signal(semaphore: semaphore_t) -> kern_return_t;
+        pub(super) fn semaphore_signal_all(semaphore: semaphore_t) -> kern_return_t;
+        pub(super) fn semaphore_wait(semaphore: semaphore_t) -> kern_return_t;
+        pub(super) fn semaphore_timedwait(
+            semaphore: semaphore_t,
+            wait_time: mach_timespec_t,
+        ) -> kern_return_t;
+        pub(super) fn semaphore_destroy(task: task_t, semaphore: semaphore_t) -> kern_return_t;
+    }
+}
+
+impl WorkerSemaphore {
+    /// Allocate a new Mach FIFO semaphore initialized to zero count.
+    pub fn new() -> Result<Self, BackendSpecificError> {
+        use mach2::{
+            kern_return::KERN_SUCCESS, mach_types::semaphore_t, port::MACH_PORT_NULL,
+            sync_policy::SYNC_POLICY_FIFO, traps::mach_task_self,
+        };
+        let mut sem: semaphore_t = MACH_PORT_NULL;
+        // SAFETY: `mach_task_self()` identifies the current task and `sem` is valid out-storage.
+        let status = unsafe {
+            mach_semaphore_ffi::semaphore_create(mach_task_self(), &mut sem, SYNC_POLICY_FIFO, 0)
+        };
+        if status != KERN_SUCCESS || sem == MACH_PORT_NULL {
+            return Err(BackendSpecificError {
+                description: format!("mach semaphore_create failed (kern_return={status})"),
+            });
+        }
+        Ok(Self { sem })
+    }
+
+    /// Wake one waiting worker thread (RT-safe Mach trap).
+    #[inline]
+    pub fn signal(&self) {
+        // SAFETY: `self.sem` is a live kernel semaphore owned until `Drop`.
+        let _ = unsafe { mach_semaphore_ffi::semaphore_signal(self.sem) };
+    }
+
+    /// Wake all currently parked worker threads (RT-safe Mach trap).
+    #[inline]
+    pub fn signal_all(&self) {
+        // SAFETY: `self.sem` is a live kernel semaphore owned until `Drop`.
+        let _ = unsafe { mach_semaphore_ffi::semaphore_signal_all(self.sem) };
+    }
+
+    /// Block the calling worker thread until signaled.
+    #[inline]
+    pub fn wait(&self) {
+        // SAFETY: `self.sem` is a live kernel semaphore owned until `Drop`.
+        let _ = unsafe { mach_semaphore_ffi::semaphore_wait(self.sem) };
+    }
+
+    /// Block the calling worker thread until signaled or `timeout` elapses.
+    /// Returns `true` if signaled (or interrupted), `false` if the timeout expired.
+    #[inline]
+    pub fn wait_timeout(&self, timeout: std::time::Duration) -> bool {
+        use mach2::{clock_types::mach_timespec_t, kern_return::KERN_OPERATION_TIMED_OUT};
+        let wait_time = mach_timespec_t {
+            tv_sec: u32::try_from(timeout.as_secs()).unwrap_or(u32::MAX),
+            tv_nsec: timeout.subsec_nanos() as i32,
+        };
+        // SAFETY: `self.sem` is a live kernel semaphore owned until `Drop`.
+        let status = unsafe { mach_semaphore_ffi::semaphore_timedwait(self.sem, wait_time) };
+        status != KERN_OPERATION_TIMED_OUT
+    }
+}
+
+impl Drop for WorkerSemaphore {
+    fn drop(&mut self) {
+        // SAFETY: destroy the owned Mach semaphore exactly once.
+        unsafe {
+            let _ = mach_semaphore_ffi::semaphore_destroy(mach2::traps::mach_task_self(), self.sem);
+        }
+    }
+}
+
+#[cfg(test)]
+mod worker_time_constraint_regression {
+    use super::{WorkerSemaphore, WorkerTimeConstraint};
+    use std::{
+        sync::Arc,
+        time::{Duration, Instant},
+    };
+
+    #[test]
+    fn worker_semaphore_signals_and_times_out() {
+        let sem = Arc::new(WorkerSemaphore::new().unwrap());
+        assert!(!sem.wait_timeout(Duration::from_millis(2)));
+        sem.signal();
+        assert!(sem.wait_timeout(Duration::from_millis(50)));
+
+        let worker_sem = Arc::clone(&sem);
+        let handle = std::thread::spawn(move || {
+            let start = Instant::now();
+            assert!(worker_sem.wait_timeout(Duration::from_secs(2)));
+            start.elapsed()
+        });
+        std::thread::sleep(Duration::from_millis(5));
+        let signal_at = Instant::now();
+        sem.signal_all();
+        let waited = handle.join().unwrap();
+        assert!(waited >= Duration::from_millis(4));
+        assert!(signal_at.elapsed() < Duration::from_millis(250));
+    }
+
+    #[test]
+    fn current_thread_repeatedly_enters_and_releases_time_constraint() {
+        let period = Duration::from_nanos(5_804_988);
+        let computation = Duration::from_micros(300);
+        let constraint = Duration::from_millis(4);
+        let mut worker =
+            WorkerTimeConstraint::for_current_thread(period, computation, constraint).unwrap();
+        assert!(worker.is_ordinary().unwrap());
+        for _ in 0..2 {
+            worker.enter().unwrap();
+            assert!(!worker.is_ordinary().unwrap());
+            assert!(
+                WorkerTimeConstraint::for_current_thread(period, computation, constraint).is_err()
+            );
+            worker.leave().unwrap();
+            assert!(worker.is_ordinary().unwrap());
+        }
+    }
+}
