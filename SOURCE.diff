+        let draft = self
+            .draft
+            .as_mut()
+            .ok_or(AudioStorageError::SourceMismatch)?;
+        draft.prepare_on_control(
+            custody,
+            self.token
+                .as_ref()
+                .ok_or(AudioStorageError::SourceMismatch)?,
+        )?;
+        draft.finish_on_control(&mut self.custody, &mut self.token, &mut self.owner)?;
+        self.owner
+            .as_mut()
+            .ok_or(AudioStorageError::SourceMismatch)?
+            .seal_sampler_constructor_on_control(
+                target,
+                Some(producer),
+                editor,
+                previous,
+                original,
+                transforms,
+                reservation,
+            )?;
