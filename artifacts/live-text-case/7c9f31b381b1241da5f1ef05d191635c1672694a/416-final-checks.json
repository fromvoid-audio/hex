[
  {
    "name": "widgets",
    "command": [
      "cargo",
      "test",
      "-p",
      "hex-widgets",
      "--locked",
      "--",
      "--nocapture"
    ],
    "exit": 0
  },
  {
    "name": "browser",
    "command": [
      "cargo",
      "test",
      "-p",
      "hex-ui",
      "--features",
      "ui-test-support",
      "--locked",
      "browser",
      "--",
      "--nocapture"
    ],
    "exit": 0
  },
  {
    "name": "clippy",
    "command": [
      "cargo",
      "clippy",
      "-p",
      "hex-ui",
      "-p",
      "hex-widgets",
      "--all-targets",
      "--features",
      "hex-ui/ui-test-support",
      "--locked",
      "--",
      "-D",
      "warnings"
    ],
    "exit": 0
  },
  {
    "name": "architecture",
    "command": [
      "python3",
      "scripts/check-architecture.py"
    ],
    "exit": 0
  },
  {
    "name": "gpui",
    "command": [
      "python3",
      "scripts/check-gpui-patch.py"
    ],
    "exit": 0
  },
  {
    "name": "style",
    "command": [
      "python3",
      "scripts/check-ui-style.py"
    ],
    "exit": 1
  }
