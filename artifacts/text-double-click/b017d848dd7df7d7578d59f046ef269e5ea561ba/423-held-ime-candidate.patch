diff --git a/crates/hex-widgets/src/tests.rs b/crates/hex-widgets/src/tests.rs
index 9a39e304..9fba3552 100644
--- a/crates/hex-widgets/src/tests.rs
+++ b/crates/hex-widgets/src/tests.rs
@@ -2335,3 +2335,164 @@ fn lowercase_numeric_presentation_preserves_raw_clipboard_parser_and_ime_offsets
