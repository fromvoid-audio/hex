+/// The renderer's exact scalar stretch predicate for one positive map segment.
+/// Does not validate map topology, source extent, mode settings or render work.
+/// Outward interval certificates must prove those conditions independently.
+pub fn validate_stretch_segment(
+    output_frames: u64,
+    source_span_q32: i128,
+    mode: Mode,
+    pitch_cents: i16,
+) -> Result<(), Error> {
+    let pitch = stretch_pitch(pitch_cents)?;
+    if output_frames == 0 || source_span_q32 <= 0 {
+        return Err(Error::Invalid(
+            "audio map must increase in source and output time",
+        ));
+    }
+    if !matches!(mode, Mode::Resample) {
+        validate_stretch_ratio(output_frames, source_span_q32, mode, pitch)?;
+    }
+    Ok(())
+}
+
+fn stretch_pitch(pitch_cents: i16) -> Result<f64, Error> {
+    if !(-4_800..=4_800).contains(&pitch_cents) {
+        return Err(Error::Invalid("invalid audio transform extent or pitch"));
+    }
+    Ok(2.0_f64.powf(f64::from(pitch_cents) / 1_200.0))
+}
+
+fn validate_stretch_ratio(
+    output_frames: u64,
+    source_span_q32: i128,
+    mode: Mode,
+    pitch: f64,
+) -> Result<(), Error> {
+    let ratio = output_frames as f64 * Q32 as f64 / source_span_q32 as f64;
+    let compensated = if matches!(mode, Mode::RePitch) {
+        ratio
+    } else {
+        ratio * pitch
+    };
+    if !(0.125 - 1e-9..=8.0 + 1e-9).contains(&compensated) {
+        return Err(Error::Invalid(
+            "warp stretch including pitch compensation must be within 1/8..8",
+        ));
+    }
+    Ok(())
+}
