+#[test]
+fn review_group_copy_response_identifies_created_members() {
+    let mut f = fixture();
+    let mut before = f.editor.project().clone();
+    let created = f
+        .editor
+        .execute(Command::MoveClipsWithOverwrite {
+            clips: vec![f.audio, f.midi],
