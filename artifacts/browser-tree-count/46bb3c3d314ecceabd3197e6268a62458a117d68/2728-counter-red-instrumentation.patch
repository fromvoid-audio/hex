diff --git a/crates/hex-ui/src/editor/browser_ui_test.rs b/crates/hex-ui/src/editor/browser_ui_test.rs
index f9f6ca35..d43994d1 100644
--- a/crates/hex-ui/src/editor/browser_ui_test.rs
+++ b/crates/hex-ui/src/editor/browser_ui_test.rs
@@ -3760,3 +3760,61 @@ fn browser_tree_same_name_files_keep_distinct_preview_paths_and_bounded_labels(
