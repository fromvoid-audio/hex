+// Diagnostic only: copied verbatim onto both pinned production baselines.
+fn review_row_navigation_fixture(
+    cx: &mut TestAppContext,
+    sample: bool,
+) -> (
+    gpui::AnyWindowHandle,
+    gpui::Entity<EditorView>,
+    PreferencesTestDirectory,
+    std::path::PathBuf,
+) {
+    cx.update(super::super::bind_editor_keys);
+    let directory = PreferencesTestDirectory::new();
+    let samples = directory.0.join("samples");
+    std::fs::create_dir_all(&samples).unwrap();
+    if !sample {
+        std::fs::create_dir(samples.join("a")).unwrap();
+        std::fs::write(samples.join("a/child.hex"), []).unwrap();
+    }
+    std::fs::write(samples.join("loop.wav"), mono_pcm_wav(24)).unwrap();
+    let handle = *cx.add_window(|_, _| Empty);
+    let editor = cx
+        .update_window(handle, |_, window, cx| {
+            window.activate_window();
+            window.replace_root(cx, |window, cx| {
+                EditorView::new_for_test_with_browser_directory(
+                    window,
+                    cx,
+                    Service::new(48_000, 32, 8_000_000).unwrap(),
+                    &directory.0,
+                )
+            })
+        })
+        .unwrap();
+    editor.update(cx, |v, cx| {
+        v.browser.auto_audition = false;
+        v.refresh_sample_catalog(cx);
+        v.request_browser_scan(samples.clone(), cx);
+    });
+    (handle, editor, directory, samples)
+}
+
+fn review_unhighlighted_row_action(
+    cx: &mut TestAppContext,
+    sample: bool,
+    escape: bool,
+    left: bool,
+) {
+    let (handle, editor, _directory, samples) = review_row_navigation_fixture(cx, sample);
+    let mut visual = VisualTestContext::from_window(handle, cx);
+    visual.run_until_parked();
+    let category = if sample {
+        "browser-place-0"
+    } else {
+        "browser-section-projects"
+    };
+    let point = visual.debug_bounds(category).unwrap().center();
+    visual.simulate_click(point, Modifiers::default());
+    visual.run_until_parked();
+    editor.read_with(&visual, |v, cx| {
+        let entries = v.browser_visible_entries(cx);
+        assert!(!entries.is_empty(), "actual async entries available");
+        assert_eq!(
+            entries[0].path,
+            if sample {
+                samples.join("loop.wav")
+            } else {
+                samples.join("a")
+            }
+        );
+    });
+    if escape || left {
+        let row = visual.debug_bounds("browser-entry-0").unwrap().center();
+        visual.simulate_click(row, Modifiers::default());
+        editor.read_with(&visual, |v, _| assert!(v.browser.results_focused));
+        if left {
+            visual.simulate_keystrokes("right");
+            visual.run_until_parked();
+            editor.read_with(&visual, |v, _| {
+                assert!((v.browser.tree.icon(&samples.join("a")) == "▾"))
+            });
+        }
+        visual.simulate_keystrokes("escape");
+    }
+    visual.update(|window, cx| {
+        editor.read_with(cx, |v, cx| {
+            assert!(!v.browser.results_focused);
+            assert!(v.browser.results_focus.is_focused(window));
+            assert_eq!(v.browser_key_context(window, cx), "hex_browser");
+        })
+    });
+    let before = editor.read_with(&visual, |v, _| {
+        (
+            v.browser.playback_generation,
+            v.browser.tree.icon(&samples.join("a")),
+            v.browser.tree.requests_started,
+        )
+    });
+    visual.simulate_keystrokes(if left { "left" } else { "right" });
+    visual.run_until_parked();
+    editor.read_with(&visual, |v, _| {
+        let after = (v.browser.playback_generation, v.browser.tree.icon(&samples.join("a")), v.browser.tree.requests_started);
+        eprintln!("ACTUAL_UNHIGHLIGHTED_ROW sample={sample} escape={escape} left={left} before={before:?} after={after:?}");
+        assert_eq!(after, before, "unhighlighted navigation must not dispatch a row action");
+        assert!(v.pending_requests.is_empty() && v.pending_audio_commands.is_empty());
+    });
+}
+
+#[gpui::test]
+fn review_unhighlighted_row_source_sample_right(cx: &mut TestAppContext) {
+    review_unhighlighted_row_action(cx, true, false, false);
+}
+#[gpui::test]
+fn review_unhighlighted_row_escape_sample_right(cx: &mut TestAppContext) {
+    review_unhighlighted_row_action(cx, true, true, false);
+}
+#[gpui::test]
+fn review_unhighlighted_row_source_folder_right(cx: &mut TestAppContext) {
+    review_unhighlighted_row_action(cx, false, false, false);
+}
+#[gpui::test]
+fn review_unhighlighted_row_escape_folder_right(cx: &mut TestAppContext) {
+    review_unhighlighted_row_action(cx, false, true, false);
+}
+#[gpui::test]
+fn review_unhighlighted_row_escape_folder_left(cx: &mut TestAppContext) {
+    review_unhighlighted_row_action(cx, false, true, true);
+}
+
+#[gpui::test]
+fn review_unhighlighted_row_selected_controls(cx: &mut TestAppContext) {
+    for sample in [false, true] {
+        let (handle, editor, _directory, samples) = review_row_navigation_fixture(cx, sample);
+        let mut visual = VisualTestContext::from_window(handle, cx);
+        visual.run_until_parked();
+        let category = if sample {
+            "browser-place-0"
+        } else {
+            "browser-section-projects"
+        };
+        let category = visual.debug_bounds(category).unwrap().center();
+        visual.simulate_click(category, Modifiers::default());
+        visual.run_until_parked();
+        let row = visual.debug_bounds("browser-entry-0").unwrap().center();
+        visual.simulate_click(row, Modifiers::default());
+        let before = editor.read_with(&visual, |v, _| {
+            assert!(v.browser.results_focused);
+            v.browser.playback_generation
+        });
+        visual.simulate_keystrokes("right");
+        visual.run_until_parked();
+        editor.read_with(&visual, |v, _| {
+            if sample {
+                assert!(v.browser.playback_generation > before);
+            } else {
+                assert!((v.browser.tree.icon(&samples.join("a")) == "▾"));
+            }
+        });
+        if !sample {
+            visual.simulate_keystrokes("left");
+            editor.read_with(&visual, |v, _| {
+                assert!(!(v.browser.tree.icon(&samples.join("a")) == "▾"))
+            });
+        }
+    }
+}
