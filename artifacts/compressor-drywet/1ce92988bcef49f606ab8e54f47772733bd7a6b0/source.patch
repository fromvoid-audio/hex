+    for mix in [0.0, 0.25, 0.75, 1.0] {
+        let state = patch(&original, parameter::DRY_WET, mix);
+        let curve = transfer_curve(&state).unwrap();
+        let gain_db =
+            20.0 * ((1.0 - f64::from(mix)) + f64::from(mix) * 10.0_f64.powf(12.0 / 20.0)).log10();
