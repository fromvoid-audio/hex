+#[test]
+fn mixed_static_curve_blends_after_makeup_in_linear_amplitude() {
+    let original = patch(
+        &patch(
+            &COMPRESSOR_DEFINITION.default_state().unwrap(),
+            parameter::RATIO,
+            1.0,
+        ),
+        parameter::MAKEUP,
+        12.0,
