+
+#[test]
+fn rms_choice_reduces_actual_short_burst_compression() {
+    let base = patch(&patch(&patch(&COMPRESSOR_DEFINITION.default_state().unwrap(), parameter::ATTACK, 0.1), parameter::THRESHOLD, -30.0), parameter::KNEE, 0.0);
+    let rms = COMPRESSOR_DEFINITION.patch_parameter(&base, ParameterId::from_static(8), ParameterValue::Choice(1)).expect("select actual RMS");
+    let mut peak_signal = [[1.0, -0.25]; 48];
+    let mut rms_signal = peak_signal;
+    runtime(&base, 48000).process_block(&mut peak_signal, &hex_lattice::EMPTY_DEVICE_RESOURCES);
+    runtime(&rms, 48000).process_block(&mut rms_signal, &hex_lattice::EMPTY_DEVICE_RESOURCES);
+    assert!(rms_signal[47][0] > peak_signal[47][0] + 0.01, "RMS really changes transient gain");
+}
