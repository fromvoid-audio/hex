+#[gpui::test]
+fn browser_insert_quantized_toggle_uses_nearest_canonical_grid_and_snapshots_mode(
+    cx: &mut TestAppContext,
+) {
+    use crate::editor::musical_time::SnapGrid;
+    for (quantized, candidate, expected) in [
