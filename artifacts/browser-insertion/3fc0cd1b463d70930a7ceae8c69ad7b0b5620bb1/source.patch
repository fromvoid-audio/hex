+#[gpui::test]
+fn browser_insert_adaptive_grid_uses_tempo_meter_and_current_viewport(cx: &mut TestAppContext) {
+    use crate::editor::musical_time::SnapGrid;
+    for zoom in [48_000, 1_500_000] {
