+struct BudgetFixture {
+    layers: SpectrumPlotLayers,
+}
+impl Render for BudgetFixture {
+    fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+        layered_spectrum_plot(self.layers.clone(), STYLE)
+    }
